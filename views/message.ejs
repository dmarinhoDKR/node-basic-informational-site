<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main>
        <header class="page-header">
            <p class="eyebrow">Mini Message Board</p>
            <h1><%= title %></h1>
        </header>

        <article class="message-card">
            <div class="message-meta">
                <strong><%= message.user %></strong>

                <time datetime="<%= message.added.toISOString() %>">
                    <%= message.added.toLocaleString("en-US", {
                        dateStyle: "medium",
                        timeStyle: "short",
                    }) %>
                </time>
            </div>

            <p><%= message.text %></p>
        </article>

        <div class="detail-actions">
            <a href="/">Back to all messages</a>
        </div>
    </main>
</body>
</html>
