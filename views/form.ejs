<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main>
        <header class="page-header">
            <p class="eyebrow">Mini Message Board</p>
            <h1><%= title %></h1>
            <p>Write a message to add it to the board.</p>
        </header>

        <form method="POST" action="/new">
            <div class="form-field">
                <label for="messageUser">Name</label>
                <input
                    id="messageUser"
                    name="messageUser"
                    type="text"
                    required
                >
            </div>

            <div class="form-field">
                <label for="messageText">Message</label>
                <textarea
                    id="messageText"
                    name="messageText"
                    rows="5"
                    required
                ></textarea>
            </div>

            <div class="form-actions">
                <button type="submit">Post message</button>
                <a href="/">Cancel</a>
            </div>
        </form>
    </main>
</body>
</html>
